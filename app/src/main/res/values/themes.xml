<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- La UI es 100 % Compose; este tema solo da el fondo de ventana y las barras del sistema. -->
    <style name="Theme.Vixa" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="colorPrimary">@color/brand</item>
        <item name="colorAccent">@color/brand</item>
    </style>

    <style name="Theme.Vixa.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FF000000</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Vixa</item>
    </style>
</resources>
